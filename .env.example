# ClaudeManager Environment Configuration
# Copy this to .env and adjust for your environment

# Host home directory (mounted read-only for folder browsing)
HOST_HOME_PATH=/c/Users/yourname

# Host directory where the backend's agents.db / files / TOTP master key persist.
# Windows: C:/ClaudeManager/agent-data   Linux: /ClaudeManager/agent-data
# If unset, docker-compose falls back to /ClaudeManager/agent-data (Linux-style).
HOST_DATA_PATH=C:/ClaudeManager/agent-data

# PrintingPress repository path (for PDF generation service)
PRINTINGPRESS_PATH=/c/Users/yourname/Documents/PrintingPress

# Public server URL (Tailscale hostname or local address)
SERVER_URL=https://your-hostname.tail12345.ts.net

# API key (optional — if set, persists across container rebuilds)
# If not set, a random key is generated and stored in the database
# API_KEY=your-64-char-hex-key-here
